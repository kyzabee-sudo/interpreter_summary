# xAI API key from https://console.x.ai
XAI_API_KEY=

# Optional overrides
XAI_MODEL=grok-4.6
XAI_BASE_URL=https://api.x.ai
MAX_UPLOAD_MB=40
# Seconds to wait between streamed response chunks. Long reasoning models
# need this higher than a single silent wait for the whole body.
REQUEST_TIMEOUT_SECONDS=1200
HOST=127.0.0.1
PORT=8000
